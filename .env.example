DEBUG=true
PROJECT_NAME=Datam Backend
API_PREFIX=/api

DB_ECHO=false

POSTGRES_PASSWORD=change-me-to-a-long-random-hex-password
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-to-another-long-random-password

SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

CORS_ORIGINS=

# AI stylist: a local Ollama server (https://ollama.com) on the host machine.
# Compose points the backend at host.docker.internal; set OLLAMA_URL only to override it.
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_TIMEOUT_SECONDS=120
